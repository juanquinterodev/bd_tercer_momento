    m.nombre AS marca,
    ce.modelo,
    ce.precio
FROM celulares ce
INNER JOIN marcas m
ON ce.id_marca = m.id_marca;

CREATE PROCEDURE sp_ventas_cliente
    @id_cliente INT,
    @cantidad_ventas INT OUTPUT
AS
BEGIN

    SELECT 
        v.id_venta,
        v.fecha,
        v.total
    FROM ventas v
    WHERE v.id_cliente = @id_cliente;

    SELECT 
        @cantidad_ventas = COUNT(*)
    FROM ventas
    WHERE id_cliente = @id_cliente;

END;
GO

-- EJECUCIÓN

DECLARE @totalVentas INT;

EXEC sp_ventas_cliente
    @id_cliente = 1,
    @cantidad_ventas = @totalVentas OUTPUT;

PRINT 'Cantidad de ventas:';
PRINT @totalVentas;

CREATE PROCEDURE sp_registrar_venta
    @fecha DATE,
    @total DECIMAL(10,2),
    @id_cliente INT
AS
BEGIN

    INSERT INTO ventas(fecha, total, id_cliente)
    VALUES(@fecha, @total, @id_cliente);

    PRINT 'Venta registrada correctamente';

END;
GO

-- EJECUCIÓN

