    '2026-05-10',
    3200000,
    1;

CREATE VIEW vista_ventas_clientes AS
SELECT
    c.nombre AS cliente,
    v.fecha,
    v.total
FROM clientes c
INNER JOIN ventas v
ON c.id_cliente = v.id_cliente;

SELECT * FROM vista_ventas_clientes;
